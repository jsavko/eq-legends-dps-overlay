{
  "name": "eq-legends-dps-overlay",
  "version": "0.2.1",
  "private": true,
  "description": "Real-time group DPS overlay for EverQuest Legends",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "replay": "node scripts/replay.js",
    "icons": "node scripts/make-icons.js",
    "collect-unknown": "node scripts/collect-unknown.js",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.eqlparser.overlay",
    "productName": "EQL DPS Overlay",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "EQL-DPS-Overlay-${version}.exe"
    }
  }
}
