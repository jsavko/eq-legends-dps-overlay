{
  "name": "eq-legends-dps-overlay",
  "version": "0.8.8",
  "private": true,
  "description": "Real-time group DPS overlay for EverQuest Legends",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "replay": "node scripts/replay.js",
    "icons": "node scripts/make-icons.js",
    "collect-unknown": "node scripts/collect-unknown.js",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.eqlparser.overlay",
    "productName": "EQL DPS Overlay",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "jsavko",
        "repo": "eq-legends-dps-overlay"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "EQL-DPS-Overlay-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "EQL-DPS-Overlay-${version}.exe"
    }
  }
}
